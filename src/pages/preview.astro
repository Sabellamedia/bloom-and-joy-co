---
// Client design preview — share this URL to let the client pick a direction
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Old City Detail — Choose Your Design</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: #0A0A0A; color: #fff; font-family: 'Inter', system-ui, sans-serif; min-height: 100vh; padding: 3rem 1.5rem 5rem; }
    .header { text-align: center; margin-bottom: 3.5rem; }
    .logo { height: 44px; filter: brightness(0) invert(1); opacity: .7; margin-bottom: 1.5rem; }
    .eyebrow { font-size: .7rem; font-weight: 600; letter-spacing: .25em; text-transform: uppercase; color: #555; margin-bottom: .75rem; }
    h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 800; color: #fff; margin-bottom: .75rem; line-height: 1.1; }
    .sub { font-size: .95rem; color: #666; max-width: 440px; margin: 0 auto; line-height: 1.6; }

    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 1.5rem; max-width: 1100px; margin: 0 auto; }

    .card { border-radius: 12px; overflow: hidden; position: relative; transition: transform .2s, box-shadow .2s; cursor: pointer; }
    .card:hover { transform: translateY(-6px); box-shadow: 0 20px 60px rgba(0,0,0,.5); }
    .card-preview { height: 300px; display: flex; flex-direction: column; justify-content: flex-end; padding: 1.75rem; position: relative; overflow: hidden; }
    .card-preview-bg { position: absolute; inset: 0; background-size: cover; background-position: center; }

    /* V1 preview bg */
    .v1-bg { background: linear-gradient(135deg, #0A0A0A 0%, #1A1408 50%, #0D0C09 100%); }
    .v1-accent { position: absolute; top: 1.5rem; right: 1.5rem; width: 48px; height: 2px; background: #C4993D; }
    .v1-accent::after { content: ''; position: absolute; top: 8px; right: 0; width: 30px; height: 1px; background: #C4993D; opacity: .5; }
    .v1-num { font-size: 6rem; font-weight: 300; color: #C4993D; opacity: .08; position: absolute; top: 1rem; left: 1.5rem; line-height: 1; font-family: Georgia, serif; }
    .v1-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: rgba(196,153,61,.15); border: 1px solid rgba(196,153,61,.15); margin-bottom: 1rem; }
    .v1-grid-cell { background: #0F0F0F; height: 48px; }

    /* V2 preview bg */
    .v2-bg { background: #F7F8FA; }
    .v2-card { background: #fff; border-radius: 8px; height: 56px; margin-bottom: .75rem; box-shadow: 0 2px 8px rgba(0,0,0,.08); display: flex; align-items: center; padding: 0 1rem; gap: .75rem; }
    .v2-dot { width: 10px; height: 10px; border-radius: 50%; background: #C41230; flex-shrink: 0; }
    .v2-line { height: 8px; background: #E5E7EB; border-radius: 4px; flex: 1; }
    .v2-line-sm { height: 6px; background: #F3F4F6; border-radius: 4px; width: 60%; }

    /* V3 preview bg */
    .v3-bg { background: #050505; }
    .v3-bar { position: absolute; top: 0; right: 0; width: 4px; height: 100%; background: #E5232E; }
    .v3-card { background: #161616; border-left: 3px solid #E5232E; padding: .75rem 1rem; margin-bottom: 2px; }
    .v3-title { font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: #fff; margin-bottom: .3rem; }
    .v3-text { font-size: .65rem; color: #555; }
    .v3-num { position: absolute; top: 1.25rem; right: 1.5rem; font-size: 5rem; font-weight: 900; color: #E5232E; opacity: .06; line-height: 1; }

    .card-info { background: #111; padding: 1.5rem; border-top: 1px solid #1E1E1E; }
    .card-version { font-size: .68rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; margin-bottom: .35rem; }
    .card-name { font-size: 1.15rem; font-weight: 700; color: #fff; margin-bottom: .4rem; }
    .card-desc { font-size: .82rem; color: #555; line-height: 1.5; margin-bottom: 1.25rem; }
    .card-tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-bottom: 1.25rem; }
    .tag { font-size: .68rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: .3rem .65rem; border-radius: 4px; background: #1A1A1A; color: #555; }
    .card-link { display: flex; align-items: center; justify-content: space-between; font-size: .82rem; font-weight: 600; color: #fff; padding: .75rem 1rem; border-radius: 6px; transition: background .15s; }
    .v1-link { background: #C4993D22; color: #C4993D; }
    .v1-link:hover { background: #C4993D33; }
    .v2-link { background: #C4123022; color: #E83050; }
    .v2-link:hover { background: #C4123033; }
    .v3-link { background: #E5232E1A; color: #E5232E; }
    .v3-link:hover { background: #E5232E2A; }

    .footer-note { text-align: center; margin-top: 3rem; font-size: .8rem; color: #333; }
    .footer-note a { color: #555; text-decoration: underline; }
    .footer-note a:hover { color: #888; }
  </style>
</head>
<body>

<div class="header">
  <img src="/logo.png" alt="Old City Detail" class="logo" />
  <p class="eyebrow">Design Preview</p>
  <h1>Pick Your Favorite Direction</h1>
  <p class="sub">Three completely different design vibes — same brand, same services. Let us know which one feels right.</p>
</div>

<div class="grid">

  <!-- V1: Luxury Dark -->
  <div class="card">
    <div class="card-preview v1-bg">
      <div class="v1-num">01</div>
      <div class="v1-accent"></div>
      <div class="v1-grid">
        <div class="v1-grid-cell"></div>
        <div class="v1-grid-cell"></div>
        <div class="v1-grid-cell"></div>
      </div>
      <div style="display:flex;align-items:flex-end;justify-content:space-between;">
        <div>
          <div style="font-family:Georgia,serif;font-size:1.5rem;font-weight:300;color:#C4993D;letter-spacing:.04em;line-height:1.1;">Detailing<br /><em>Excellence.</em></div>
          <div style="font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:#7A7670;margin-top:.5rem;">Old City Detail</div>
        </div>
        <div style="border:1px solid rgba(196,153,61,.4);color:#C4993D;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;padding:.5rem 1rem;">Reserve</div>
      </div>
    </div>
    <div class="card-info">
      <p class="card-version" style="color:#C4993D;">Version 01</p>
      <p class="card-name">Luxury Dark</p>
      <p class="card-desc">Deep black backgrounds, gold accents, and elegant serif typography. Think high-end, understated, premium.</p>
      <div class="card-tags">
        <span class="tag">Dark</span>
        <span class="tag">Gold Accents</span>
        <span class="tag">Serif Font</span>
        <span class="tag">Elegant</span>
      </div>
      <a href="/v1" target="_blank" class="card-link v1-link">
        View Version 1
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>

  <!-- V2: Clean Light -->
  <div class="card">
    <div class="card-preview v2-bg">
      <div style="background:#0D1B2A;padding:.6rem 1rem;margin-bottom:.75rem;display:flex;align-items:center;justify-content:space-between;">
        <div style="display:flex;gap:1rem;">
          <span style="font-size:.55rem;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.1em;text-transform:uppercase;">Services</span>
          <span style="font-size:.55rem;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.1em;text-transform:uppercase;">About</span>
          <span style="font-size:.55rem;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:.1em;text-transform:uppercase;">Contact</span>
        </div>
        <div style="background:#C41230;color:#fff;font-size:.55rem;font-weight:700;padding:.25rem .6rem;border-radius:3px;">Book Now</div>
      </div>
      <div class="v2-card">
        <div class="v2-dot"></div>
        <div>
          <div class="v2-line" style="width:80%;margin-bottom:.3rem;background:#0D1B2A;opacity:.12;"></div>
          <div class="v2-line-sm" style="background:#E5E7EB;"></div>
        </div>
      </div>
      <div class="v2-card">
        <div class="v2-dot" style="background:#0D1B2A;opacity:.3;"></div>
        <div>
          <div class="v2-line" style="width:65%;margin-bottom:.3rem;background:#0D1B2A;opacity:.08;"></div>
          <div class="v2-line-sm"></div>
        </div>
      </div>
      <div class="v2-card">
        <div class="v2-dot" style="background:#0D1B2A;opacity:.3;"></div>
        <div>
          <div class="v2-line" style="width:55%;margin-bottom:.3rem;background:#0D1B2A;opacity:.08;"></div>
          <div class="v2-line-sm"></div>
        </div>
      </div>
    </div>
    <div class="card-info">
      <p class="card-version" style="color:#E83050;">Version 02</p>
      <p class="card-name">Clean & Modern</p>
      <p class="card-desc">Light backgrounds, navy and red accents, bold clean typography. Professional, trustworthy, approachable.</p>
      <div class="card-tags">
        <span class="tag">Light</span>
        <span class="tag">Navy & Red</span>
        <span class="tag">Sans-Serif</span>
        <span class="tag">Professional</span>
      </div>
      <a href="/v2" target="_blank" class="card-link v2-link">
        View Version 2
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>

  <!-- V3: Bold Performance -->
  <div class="card">
    <div class="card-preview v3-bg">
      <div class="v3-bar"></div>
      <div class="v3-num">03</div>
      <div style="margin-bottom:.75rem;">
        <div style="font-family:'Arial Black',sans-serif;font-size:1.8rem;font-weight:900;text-transform:uppercase;letter-spacing:.02em;line-height:.9;color:#fff;margin-bottom:.5rem;">DETAILING<br /><span style="color:#E5232E;">EXCELLENCE.</span></div>
        <div style="font-size:.6rem;font-weight:700;letter-spacing:.25em;text-transform:uppercase;color:#555;">Old City Detail · St. Augustine</div>
      </div>
      <div>
        <div class="v3-card">
          <div class="v3-title">Auto Detailing</div>
          <div class="v3-text">Hand wash, decontamination, wax & sealant</div>
        </div>
        <div class="v3-card">
          <div class="v3-title">Boat Detailing</div>
          <div class="v3-text">Wash, wax, oxidation removal & more</div>
        </div>
      </div>
    </div>
    <div class="card-info">
      <p class="card-version" style="color:#E5232E;">Version 03</p>
      <p class="card-name">Bold Performance</p>
      <p class="card-desc">Pure black, electric red, angular design elements, and condensed sport typography. High-energy, aggressive, memorable.</p>
      <div class="card-tags">
        <span class="tag">Dark</span>
        <span class="tag">Red Accents</span>
        <span class="tag">Condensed Font</span>
        <span class="tag">Sporty</span>
      </div>
      <a href="/v3" target="_blank" class="card-link v3-link">
        View Version 3
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
      </a>
    </div>
  </div>

</div>

<p class="footer-note">
  Share this page with your client: <strong>/preview</strong> &nbsp;·&nbsp;
  <a href="/">View current live site →</a>
</p>

</body>
</html>
