---
import site from '../data/site.json';
import images from '../data/images.json';

const premiumOffers = [
  {
    id: 'ceramic',
    badge: 'Most Popular',
    title: 'Ceramic Coating',
    tagline: 'Protect your investment for years — not weeks.',
    description: 'Professional ceramic coating locks in showroom gloss, repels water & UV, and makes every wash easier. Our most requested upgrade.',
    benefits: ['1, 3 & 5 year protection tiers', 'Hydrophobic & UV protection', 'Pairs perfectly with paint correction'],
    prices: 'From +$125 add-on · up to +$500 for 5-year Platinum',
    image: images.packages.ceramic,
    cta: { label: 'See Ceramic Pricing', href: '#ceramic-pricing' },
  },
  {
    id: 'paint-correction',
    badge: 'Best Results',
    title: 'Paint Correction',
    tagline: 'Fix the swirls before you seal the shine.',
    description: 'Multi-step machine polishing removes oxidation, swirl marks, and haze — the essential prep for ceramic coating or a true showroom finish.',
    benefits: ['1, 2 & 3 step correction levels', 'Restores depth, gloss & clarity', 'Recommended before ceramic coating'],
    prices: 'From +$500 · up to +$900 for 3-step correction',
    image: images.packages['paint-correction'],
    cta: { label: 'See Correction Pricing', href: '#paint-correction-pricing' },
  },
];
---

<section id="premium-services" class="relative overflow-hidden bg-white py-16 md:py-24">
  <div class="absolute inset-0 bg-gradient-to-b from-red-50/80 to-white pointer-events-none" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4">
    <div class="text-center">
      <p class="font-heading text-xs font-bold uppercase tracking-[0.2em] text-brand-red">Premium Protection</p>
      <h2 class="section-heading mt-2">Ceramic Coating &amp; Paint Correction</h2>
      <div class="section-underline"></div>
      <p class="mt-4 max-w-2xl mx-auto text-gray-600">
        Our highest-value services — built to protect your paint, maximize resale value, and keep your vehicle looking new for years.
      </p>
    </div>

    <div class="mt-12 grid gap-8 lg:grid-cols-2">
      {premiumOffers.map((offer) => (
        <article class="group flex flex-col overflow-hidden rounded-xl border-2 border-brand-red/20 bg-white shadow-lg transition hover:border-brand-red/50 hover:shadow-xl">
          <div class="relative h-52 overflow-hidden sm:h-60">
            <img
              src={offer.image}
              alt={offer.title}
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
              loading="lazy"
            />
            <span class="absolute left-4 top-4 rounded bg-brand-red px-3 py-1 font-heading text-xs font-bold uppercase tracking-wide text-white shadow-md">
              {offer.badge}
            </span>
          </div>
          <div class="flex flex-1 flex-col p-6 md:p-8">
            <h3 class="font-heading text-xl font-bold uppercase tracking-wide text-brand-black md:text-2xl">{offer.title}</h3>
            <p class="mt-2 font-heading text-sm font-semibold text-brand-red">{offer.tagline}</p>
            <p class="mt-3 text-sm leading-relaxed text-gray-600">{offer.description}</p>
            <ul class="mt-5 space-y-2">
              {offer.benefits.map((benefit) => (
                <li class="flex items-start gap-2 text-sm text-gray-700">
                  <span class="mt-0.5 text-brand-red">✓</span> {benefit}
                </li>
              ))}
            </ul>
            <p class="mt-5 font-heading text-sm font-bold text-brand-black">{offer.prices}</p>
            <div class="mt-6 flex flex-col gap-3 sm:flex-row">
              <a href={offer.cta.href} class="btn-primary flex-1 justify-center !py-3.5">
                {offer.cta.label}
              </a>
              <a href={`tel:${site.phoneLink}`} class="btn-outline-dark flex-1 justify-center !py-3.5">
                Call for Quote
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-10 rounded-xl border border-brand-red/30 bg-brand-black px-6 py-8 text-center md:px-10">
      <p class="font-heading text-lg font-bold uppercase text-white md:text-xl">
        Pro Tip: Paint Correction + Ceramic = Maximum Results
      </p>
      <p class="mt-2 text-sm text-gray-400">
        Ask about bundling correction and coating — we'll build a quote for your vehicle.
      </p>
      <a href="#contact" class="btn-primary mt-6 inline-flex !px-8 !py-3.5">
        Get a Premium Quote
      </a>
    </div>
  </div>
</section>
