---
import services from '../data/services.json';
import images from '../data/images.json';
import site from '../data/site.json';
import SectionIntro from './SectionIntro.astro';

type ServiceImageKey = keyof typeof images.services;
---

<section id="services" class="section-shell bg-brand-cream">
  <div class="mx-auto max-w-6xl px-4 md:px-6">
    <div data-reveal>
      <SectionIntro
        eyebrow="Our craft"
        title="Services tailored to your celebration"
        lead="From statement garlands to coordinated party details and specialty rentals — each element is designed, styled, and installed with boutique-level care."
      />
    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-2">
      {services.map((service, index) => (
        <article class="card-boutique group" data-reveal data-reveal-delay={String((index % 2) + 1)}>
          <div class="relative aspect-[4/3] overflow-hidden">
            <img
              src={images.services[service.imageKey as ServiceImageKey]}
              alt={service.title}
              class="h-full w-full object-cover transition duration-700 group-hover:scale-[1.03]"
              loading="lazy"
            />
            <span class="absolute left-5 top-5 font-display text-5xl font-light text-white/90">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="border-t border-brand-blush-dark p-8 md:p-10">
            <h3 class="font-display text-2xl font-medium text-brand-charcoal">{service.title}</h3>
            <p class="mt-3 text-sm font-light leading-relaxed text-brand-mauve-dark">{service.description}</p>
            <ul class="mt-6 space-y-2.5 border-t border-brand-blush-dark/70 pt-6">
              {service.highlights.map((item) => (
                <li class="flex items-start gap-3 text-sm font-light text-brand-charcoal">
                  <span class="mt-2 h-px w-4 shrink-0 bg-brand-mauve"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-16 text-center" data-reveal>
      <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-accent">
        Begin your inquiry
      </a>
    </div>
  </div>
</section>
