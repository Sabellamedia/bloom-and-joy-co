---
import site from '../data/site.json';
import Logo from './Logo.astro';

const navLinks = [
  { href: '#services', label: 'Services' },
  { href: '#packages', label: 'Collections' },
  { href: '#process', label: 'Process' },
  { href: '#gallery', label: 'Portfolio' },
  { href: '#about', label: 'Studio' },
  { href: '#contact', label: 'Inquire' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 pt-[env(safe-area-inset-top,0px)]">
  <div class="border-b border-brand-blush-dark/60 bg-brand-cream/90 backdrop-blur-lg">
    <div class="mx-auto flex h-[5.75rem] max-w-6xl items-center justify-between gap-4 px-4 md:px-6">
      <a href="#home" class="flex shrink-0 items-center" aria-label={`${site.name} — home`}>
        <Logo />
      </a>

      <ul class="hidden items-center gap-8 lg:flex">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class="nav-link font-heading text-[0.68rem] font-medium uppercase tracking-boutique text-brand-charcoal/80 transition hover:text-brand-charcoal"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>

      <div class="flex items-center gap-3">
        <a
          href={site.bookingUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-accent hidden !px-5 !py-2.5 sm:inline-flex"
        >
          Inquire
        </a>
        <button
          id="mobile-menu-btn"
          type="button"
          class="btn-secondary !px-4 !py-2.5 lg:hidden"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          Menu
        </button>
      </div>
    </div>
  </div>
</header>

<div id="header-spacer" aria-hidden="true"></div>

<div id="mobile-menu" class="fixed inset-0 z-[60] hidden lg:hidden" aria-hidden="true">
  <div class="absolute inset-0 bg-brand-charcoal/40 backdrop-blur-sm" data-close-menu aria-hidden="true"></div>
  <div class="absolute right-0 top-0 flex h-full w-full max-w-sm flex-col bg-brand-cream">
    <div class="flex items-center justify-between border-b border-brand-blush-dark px-6 py-5">
      <span class="font-heading text-[0.68rem] font-medium uppercase tracking-boutique text-brand-charcoal">Menu</span>
      <button id="mobile-menu-close" type="button" class="text-brand-charcoal/70 transition hover:text-brand-charcoal" aria-label="Close menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <nav class="flex flex-1 flex-col gap-1 p-4" aria-label="Mobile navigation">
      {navLinks.map((link) => (
        <a
          href={link.href}
          data-close-menu
          class="nav-link-mobile border border-transparent px-5 py-4 font-heading text-sm font-medium uppercase tracking-boutique text-brand-charcoal transition hover:border-brand-blush-dark hover:bg-brand-linen"
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div class="space-y-3 border-t border-brand-blush-dark p-6">
      <a href={site.social.instagram} target="_blank" rel="noopener noreferrer" class="block text-center text-sm text-brand-mauve-dark hover:text-brand-charcoal">
        @bloomandjoyjax
      </a>
      <a href={site.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn-accent block w-full py-4 text-center">
        Inquire for Your Event
      </a>
    </div>
  </div>
</div>
